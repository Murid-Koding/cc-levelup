{
  "name": "cc-levelup",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "nuxi typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cc-levelup-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply cc-levelup-db --remote"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "dependencies": {
    "@nuxtjs/i18n": "^9.0.0",
    "@primevue/core": "^4.3.1",
    "@primevue/forms": "^4.3.1",
    "@primevue/nuxt-module": "^4.3.1",
    "@primevue/themes": "^4.3.1",
    "drizzle-orm": "^0.38.4",
    "nuxt": "^4.0.0",
    "primevue": "^4.3.1",
    "vue": "^3.5.13",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^3.15.4",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "@unocss/nuxt": "^66.0.0",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "unocss": "^66.0.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0",
    "wrangler": "^3.109.2"
  }
}
